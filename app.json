{
  "expo": {
    "name": "Pettii",
    "slug": "pettii",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon-white.png",
    "scheme": "pettii",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.pettii.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Pettii needs access to your photo library so you can select photos and videos of your pet to upload to your pet’s profile and share them in the community feed. For example, you can choose a photo or video from your gallery and publish it as a post.",
        "NSPhotoLibraryAddUsageDescription": "Pettii may need permission to save photos or videos to your photo library when media is edited or prepared for sharing. For example, a pet photo edited in the app may be saved to your gallery before being posted."
      }
    },
    "android": {
      "package": "com.pettii.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/loading2.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba6c9daa-a39a-4573-80f0-b1ffebee9961"
      }
    }
  }
}
